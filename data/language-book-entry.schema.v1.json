{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilanguage.org/data/language-book-entry.schema.v1.json",
  "title": "Language Book Entry Schema v1.0",
  "type": "object",
  "required": ["schema_version", "dataset_version", "product", "author", "editorial_policy", "status_enums", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset_version": { "const": "1.2.18" },
    "product": { "$ref": "#/$defs/localized" },
    "author": { "const": "Jinkai Liu" },
    "editorial_policy": { "type": "object", "required": ["publication_boundary", "data_separation", "non_cognacy_position"] },
    "status_enums": { "type": "object" },
    "entries": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "zh-Hans"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "zh-Hans": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "statusTrack": {
      "type": "object",
      "required": ["status", "confidence", "summary", "items", "source_refs"],
      "properties": {
        "status": { "enum": ["Established", "Supported", "Candidate", "Interpretive", "Under review", "Unestablished", "Rejected", "Not claimed", "Not evaluated"] },
        "confidence": { "enum": ["High", "Medium", "Low", "Unknown"] },
        "summary": { "$ref": "#/$defs/localized" },
        "items": { "type": "array" },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "slug", "title", "languages", "primary_mapping", "entry_status", "mapping_status", "mapping_level", "historical_relation_status", "evidence", "phonetic_observation", "semantic_structure", "hypotheses", "experiments", "literary_layer", "media", "references", "author", "version", "dates", "editorial_notes", "search_terms"],
      "properties": {
        "diachronic_semantic_mapping": {
          "type": "object",
          "required": [
            "historical_path",
            "semantic_path",
            "historical_stages",
            "boundary"
          ],
          "properties": {
            "historical_path": {
              "type": "string"
            },
            "semantic_path": {
              "type": "string"
            },
            "historical_stages": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4
            },
            "semantic_best_path": false,
            "consonant_constrained_path": false
          }
        },
        "consonant_group_mapping": {
          "type": "object",
          "required": [
            "principle",
            "definitions",
            "predicted_groups",
            "workflow",
            "candidates",
            "dialect_diachronic_chinese_evidence",
            "independent_observations"
          ],
          "properties": {
            "workflow": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7
            },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "source_unit",
                  "source_language",
                  "target",
                  "reading",
                  "semantic_evaluation",
                  "consonant_comparison",
                  "status",
                  "historical_relation",
                  "scores",
                  "source_refs"
                ],
                "properties": {
                  "status": {
                    "const": "Phonetic-Semantic Candidate"
                  },
                  "historical_relation": {
                    "const": "Not claimed"
                  }
                }
              }
            }
          }
        },
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "record_kind": { "enum": ["lexical_entry", "named_entity"] },
        "entity_types": {
          "type": "array",
          "items": { "enum": ["proper_name", "place", "named_entity"] },
          "uniqueItems": true
        },
        "name_analysis": {
          "type": "object",
          "required": ["tibetan_form", "wylie", "orthography_note", "morphemes", "chinese_name_assessment", "translation_assessments"],
          "properties": {
            "tibetan_form": { "type": "string", "minLength": 1 },
            "wylie": { "type": "string", "minLength": 1 },
            "morphemes": { "type": "array", "minItems": 1 },
            "translation_assessments": { "type": "array", "minItems": 1 }
          }
        },
        "title": { "$ref": "#/$defs/localized" },
        "languages": { "type": "array", "minItems": 2 },
        "primary_mapping": {
          "type": "object",
          "required": ["mapping_id", "source", "target", "gloss", "meaning", "mapping_type", "rationale"],
          "properties": {
            "mapping_id": { "type": "string" },
            "source": { "type": "object", "required": ["language", "word", "pronunciation"] },
            "target": { "type": "object", "required": ["language", "word", "pronunciation"] },
            "gloss": { "$ref": "#/$defs/localized" },
            "meaning": { "$ref": "#/$defs/localized" },
            "mapping_type": { "type": "string", "minLength": 1 },
            "rationale": { "$ref": "#/$defs/localized" }
          },
          "additionalProperties": false
        },
        "entry_status": { "enum": ["Draft", "Reviewed", "Published", "Archived"] },
        "translation_status": { "enum": ["Supported", "Under review"] },
        "translation_source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "active_association_status": { "type": "string", "minLength": 1 },
        "mapping_status": { "enum": ["Candidate", "Reviewed", "Supported", "Rejected"] },
        "mapping_level": { "enum": ["A", "B", "C", "D", "Unrated"] },
        "historical_relation_status": { "enum": ["Established", "Supported", "Unestablished", "Rejected", "Not claimed"] },
        "evidence": {
          "type": "object",
          "required": ["Historical", "Phonetic-Semantic", "Cognitive", "Speculative"],
          "properties": {
            "Historical": { "$ref": "#/$defs/statusTrack" },
            "Phonetic-Semantic": { "$ref": "#/$defs/statusTrack" },
            "Cognitive": { "$ref": "#/$defs/statusTrack" },
            "Speculative": { "$ref": "#/$defs/statusTrack" }
          },
          "additionalProperties": false
        },
        "phonetic_observation": { "type": "array" },
        "query_views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["terms", "primary_mapping", "featured_mapping"],
            "properties": {
              "terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "primary_mapping": { "$ref": "#/$defs/entry/properties/primary_mapping" },
              "translation_status": { "enum": ["Supported", "Under review"] },
              "translation_source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "featured_mapping": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/entry/properties/featured_mapping" }] }
            },
            "additionalProperties": false
          }
        },
        "semantic_structure": { "type": "object", "required": ["concepts", "relation", "status"] },
        "root_level_mapping": {
          "type": "object",
          "required": ["version", "translation", "featured_structural_mapping", "latin_decomposition", "semantic_primitives", "chinese_structural_candidates", "geometry_mapping", "traditional_chinese_construction", "whole_candidates", "evidence_boundary"],
          "properties": {
            "version": { "const": "1.0" },
            "translation": { "type": "object", "required": ["source", "target", "status"] },
            "featured_structural_mapping": {
              "type": "object",
              "required": ["source", "target", "reading", "status", "historical_relation", "boundary"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 },
                "reading": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 },
                "historical_relation": { "type": "string", "minLength": 1 },
                "boundary": { "$ref": "#/$defs/localized" }
              },
              "additionalProperties": false
            },
            "latin_decomposition": { "type": "object", "required": ["status", "chain", "components", "modern_verse_note"] },
            "semantic_primitives": { "type": "array", "minItems": 3, "items": { "type": "string" } },
            "chinese_structural_candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["character", "reading", "roles", "evidence_status", "candidate_grade", "historical_relation", "note"]
              }
            },
            "geometry_mapping": { "type": "object", "required": ["status", "chain", "boundary"] },
            "traditional_chinese_construction": { "type": "object", "required": ["status", "chain", "boundary"] },
            "whole_candidates": { "type": "array", "items": { "type": "string" } },
            "evidence_boundary": { "$ref": "#/$defs/localized" }
          },
          "additionalProperties": false
        },
        "featured_mapping": {
          "type": "object",
          "required": ["source", "target", "reading", "display_label", "status", "historical_relation", "boundary", "source_refs"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "reading": { "type": "string", "minLength": 1 },
            "display_label": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "minLength": 1 },
            "historical_relation": { "type": "string", "minLength": 1 },
            "boundary": { "$ref": "#/$defs/localized" },
            "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "related_words": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["word", "language", "relationship_type", "family", "relation_to_entry", "status", "source_refs"],
            "properties": {
              "word": { "type": "string", "minLength": 1 },
              "language": { "type": "string", "minLength": 1 },
              "relationship_type": { "type": "string", "minLength": 1 },
              "family": { "type": "string", "minLength": 1 },
              "relation_to_entry": { "$ref": "#/$defs/localized" },
              "status": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "semantic_associations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["association_id", "relation", "status", "is_etymological"],
            "properties": {
              "association_id": { "type": "string", "minLength": 1 },
              "relation": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "is_etymological": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "hypotheses": { "type": "array" },
        "experiments": { "type": "array" },
        "literary_layer": { "type": "object", "required": ["status", "is_historical_evidence", "proposition", "essay_prose", "poem_lyrics", "translations", "archival_manuscript_media", "evidence_boundary"], "properties": { "is_historical_evidence": { "const": false } } },
        "media": { "type": "array" },
        "references": { "type": "array" },
        "author": { "const": "Jinkai Liu" },
        "version": { "type": "string" },
        "dates": { "type": "object", "required": ["created", "modified", "published"] },
        "editorial_notes": { "type": "array", "items": { "$ref": "#/$defs/localized" } },
        "search_terms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source": {
          "type": "object",
          "required": ["type", "author", "status", "normalization", "raw_note"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "author": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "minLength": 1 },
            "normalization": { "type": "string", "minLength": 1 },
            "raw_note": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "page": { "type": ["string", "null"] },
        "legacy": { "type": ["object", "null"] }
      }
    }
  }
}
