{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language.vu/data/candidates/package-f-review.schema.json",
  "title": "Package F candidate source-verification and human-review queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "package_version", "schema_version", "created_at", "baseline_batch", "baseline_record_count", "scope_rule", "workflow", "evidence_track_definitions", "status_summary", "records"],
  "properties": {
    "package": { "const": "Package F — Candidate Source Verification + Human Review" },
    "package_version": { "const": "0.1.0" },
    "schema_version": { "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date" },
    "baseline_batch": { "const": "data/candidates/package-e-batch-001.v0.2.json" },
    "baseline_record_count": { "const": 19 },
    "scope_rule": { "type": "string", "minLength": 1 },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_states", "transitions", "publication_state", "publication_is_separate_gate", "promotion_rule"],
      "properties": {
        "review_states": { "const": ["candidate", "reviewed", "rejected", "needs_evidence"] },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "needs_evidence"],
          "properties": {
            "candidate": { "const": ["reviewed", "rejected", "needs_evidence"] },
            "needs_evidence": { "const": ["candidate", "rejected"] }
          }
        },
        "publication_state": { "const": "published" },
        "publication_is_separate_gate": { "const": true },
        "promotion_rule": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_track_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linguistic_etymological", "phonetic", "semantic_cognitive", "speculative_association"],
      "properties": {
        "linguistic_etymological": { "type": "string", "minLength": 1 },
        "phonetic": { "type": "string", "minLength": 1 },
        "semantic_cognitive": { "type": "string", "minLength": 1 },
        "speculative_association": { "type": "string", "minLength": 1 }
      }
    },
    "status_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "reviewed", "rejected", "needs_evidence", "published"],
      "properties": {
        "candidate": { "type": "integer", "minimum": 0 },
        "reviewed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "needs_evidence": { "type": "integer", "minimum": 0 },
        "published": { "type": "integer", "minimum": 0 }
      }
    },
    "records": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_id", "source_type", "title", "locator", "url", "specific_location", "accessed_at", "version_info", "verifiable_content", "supports", "does_not_support"],
      "properties": {
        "verification_id": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["project-primary-source", "authoritative-bilingual-dictionary", "academic-research", "historical-primary-source", "corpus"] },
        "title": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "specific_location": { "type": "string", "minLength": 1 },
        "accessed_at": { "type": "string", "format": "date" },
        "version_info": { "type": "string", "minLength": 1 },
        "verifiable_content": { "type": "string", "minLength": 1 },
        "supports": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "does_not_support": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supports", "limits"],
      "properties": {
        "status": { "enum": ["supported", "partial", "not_supported", "not_assessed"] },
        "supports": { "type": "string", "minLength": 1 },
        "limits": { "type": "string", "minLength": 1 }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "complete"],
      "properties": { "item": { "type": "string", "minLength": 1 }, "complete": { "const": false } }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_word", "normalized_form", "baseline_record", "scoped_analysis", "source_verification", "evidence_tracks", "provisional_assessment", "counterexamples_uncertainties_conflicts", "human_review"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^CAND-[a-z]{2,3}-[a-z0-9-]+-[0-9]{3}$" },
        "source_word": { "type": "string", "minLength": 1 },
        "normalized_form": { "type": "string", "minLength": 1 },
        "baseline_record": { "type": "object" },
        "scoped_analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["part_of_speech", "selected_sense", "reviewed_candidate_mapping", "mapping_type", "claim_boundary"],
          "properties": {
            "part_of_speech": { "type": "string", "minLength": 1 },
            "selected_sense": { "type": "string", "minLength": 1 },
            "reviewed_candidate_mapping": { "type": "string", "minLength": 1 },
            "mapping_type": { "const": "lexical-equivalent-candidate" },
            "claim_boundary": { "type": "string", "minLength": 1 }
          }
        },
        "source_verification": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/sourceVerification" } },
        "evidence_tracks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linguistic_etymological", "phonetic", "semantic_cognitive", "speculative_association"],
          "properties": {
            "linguistic_etymological": { "$ref": "#/$defs/track" },
            "phonetic": { "$ref": "#/$defs/track" },
            "semantic_cognitive": { "$ref": "#/$defs/track" },
            "speculative_association": { "$ref": "#/$defs/track" }
          }
        },
        "provisional_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_status", "confidence", "mapping_level", "level_is_provisional", "reason", "publication_status", "automatic_publication_allowed"],
          "properties": {
            "review_status": { "enum": ["candidate", "reviewed", "rejected", "needs_evidence"] },
            "confidence": { "enum": ["low", "medium", "high"] },
            "mapping_level": { "enum": ["A", "B", "C", "D"] },
            "level_is_provisional": { "const": true },
            "reason": { "type": "string", "minLength": 1 },
            "publication_status": { "const": "not_published" },
            "automatic_publication_allowed": { "const": false }
          }
        },
        "counterexamples_uncertainties_conflicts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "human_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reviewed_at", "decision", "rationale", "checklist", "allowed_decisions", "publish_requires_separate_gate"],
          "properties": {
            "reviewer": { "type": "null" },
            "reviewed_at": { "type": "null" },
            "decision": { "type": "null" },
            "rationale": { "type": "null" },
            "checklist": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/checklistItem" } },
            "allowed_decisions": { "const": ["reviewed", "rejected", "needs_evidence"] },
            "publish_requires_separate_gate": { "const": true }
          }
        }
      }
    }
  }
}
